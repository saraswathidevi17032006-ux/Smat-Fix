# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origins (comma-separated, for CORS)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# MongoDB Connection String (replace with your local or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/smartfix

# JWT Secret & Expiration (replace with a long random string)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
